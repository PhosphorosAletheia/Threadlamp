{
  "manifest_version": 3,
  "name": "Threadlamp",
  "version": "1.13.1",
  "minimum_chrome_version": "116",
  "description": "Manage ChatGPT follow-ups, prompt queues, and scheduled check-ins from one dashboard.",
  "permissions": [
    "activeTab",
    "storage",
    "offscreen",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Threadlamp \u2014 Phosphoros Research",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "server-link.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "version_name": "1.13.1 beta 1",
  "author": "Phosphoros Research",
  "homepage_url": "https://phosphoros-research.pages.dev/",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
